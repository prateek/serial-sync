+  let sequence = 0
+
+  async function refresh(required = false) {
+    const request = ++sequence
+    if (seriesId.value === null) {
+      previous.value = next.value = null
+      return
+    }
+    try {
+      const response = await api(`/api/v1/series/${seriesId.value}/books/${bookId}/neighbors?formatGroup=epub`)
+      if (!response.ok) throw new Error('Series navigation unavailable')
+      const result = (await response.json()) as SeriesNeighborsResponse
+      if (request === sequence) {
+        previous.value = result.previous
+        next.value = result.next
+      }
+    } catch (error) {
+      if (required) throw error
+      if (request === sequence) previous.value = next.value = null
+    }
+  }
+
+  function whenVisible() {
+    if (document.visibilityState === 'visible') void refresh()
+  }
+  watch(seriesId, () => refresh(), { immediate: true })
+  onMounted(() => {
+    timer = setInterval(whenVisible, 60_000)
+    document.addEventListener('visibilitychange', whenVisible)
+    window.addEventListener('focus', whenVisible)
+  })
+  onUnmounted(() => {
+    sequence++
+    clearInterval(timer)
+    document.removeEventListener('visibilitychange', whenVisible)
+    window.removeEventListener('focus', whenVisible)
+  })
+  return { previous, next, refresh }
+}
