#!/bin/sh
set -eu

DISPLAY_VALUE="${DISPLAY:-:99}"
SCREEN_SIZE="${XVFB_SCREEN_SIZE:-1366x768x24}"
NOVNC_PORT="${NOVNC_PORT:-8080}"
VNC_PORT="${VNC_PORT:-5900}"
NOVNC_WEB_ROOT="${NOVNC_WEB_ROOT:-/usr/share/novnc}"

xvfb_pid=""
fluxbox_pid=""
x11vnc_pid=""
websockify_pid=""
app_pid=""

cleanup() {
  pids="$app_pid $websockify_pid $x11vnc_pid $fluxbox_pid $xvfb_pid"
  for pid in $pids; do kill "$pid" 2>/dev/null || true; done
  attempts=0
  while [ "$attempts" -lt 50 ]; do
    alive=false
    for pid in $pids; do
      if kill -0 "$pid" 2>/dev/null; then alive=true; fi
    done
    if [ "$alive" = false ]; then break; fi
    attempts=$((attempts + 1))
    sleep 0.1
  done
  for pid in $pids; do
    kill -KILL "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

export DISPLAY="$DISPLAY_VALUE"

if [ ! -e "/tmp/.X11-unix/X${DISPLAY#:}" ]; then
  Xvfb "$DISPLAY" -screen 0 "$SCREEN_SIZE" -nolisten tcp -ac >/tmp/serial-sync-xvfb.log 2>&1 &
  xvfb_pid="$!"
  attempts=0
  while [ ! -S "/tmp/.X11-unix/X${DISPLAY#:}" ]; do
    if ! kill -0 "$xvfb_pid" 2>/dev/null || [ "$attempts" -ge 50 ]; then
      echo "Xvfb failed to become ready; see /tmp/serial-sync-xvfb.log" >&2
      exit 1
    fi
    attempts=$((attempts + 1))
    sleep 0.1
  done
fi

fluxbox >/tmp/serial-sync-fluxbox.log 2>&1 &
fluxbox_pid="$!"

x11vnc -display "$DISPLAY" -rfbport "$VNC_PORT" -localhost -shared -forever -nopw >/tmp/serial-sync-x11vnc.log 2>&1 &
x11vnc_pid="$!"

websockify --web "$NOVNC_WEB_ROOT" "$NOVNC_PORT" "localhost:$VNC_PORT" >/tmp/serial-sync-websockify.log 2>&1 &
websockify_pid="$!"

echo "noVNC available at http://127.0.0.1:${NOVNC_PORT}/vnc.html?autoconnect=true&resize=scale"

/usr/local/bin/serial-sync "$@" &
app_pid="$!"
status=0
wait "$app_pid" || status="$?"
app_pid=""
exit "$status"
