---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content } from '../../../docs/docker-quickstart.md';
import { withBase } from '../lib/site';
---

<BaseLayout
  title="Getting Started | serial-sync"
  description="A credential-free Docker fixture, then one creator and offline authoring."
  currentPath="/getting-started/"
>
  <div class="page">
    <section class="section">
      <p class="eyebrow">Getting started</p>
      <p>After the fixture, continue to the <a href={withBase('/first-source/')}>first-creator walkthrough</a>.</p>
      <div class="guide"><Content /></div>
    </section>
  </div>
</BaseLayout>

<style>
  .guide :global(pre) { overflow-x: auto; padding: 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; white-space: pre-wrap; }
  .guide :global(h2) { margin-top: 2rem; }
</style>
